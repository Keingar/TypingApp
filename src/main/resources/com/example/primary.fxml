<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.PrimaryController">
   <children>
      <Label fx:id="targetLabel" wrapText="true" style="-fx-font-size: 20px;" />
      <TextField fx:id="input" style="-fx-font-size: 18px;" />
      <HBox fx:id="resultBox" alignment="CENTER" spacing="15.0" visible="false">
         <children>
            <Label fx:id="resultLabel" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
            <Button text="Again" onAction="#again" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
